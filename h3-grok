#!/usr/bin/env python3
"""Pull and send plain-text H3 prompt projects through Grok Bridge."""

from __future__ import annotations

import argparse
import configparser
import hashlib
import json
import math
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any


FORMAT = "h3_grok_bridge_workspace_v1"
STATE_FILE = ".h3-grok-bridge.ini"
PREFIX = "/minimax_h3_grok_bridge"
MAX_IMAGE_BYTES = 100 * 1024 * 1024


class CliError(RuntimeError):
    pass


def text_hash(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8")).hexdigest()


def atomic_text(path: Path, value: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(value)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def atomic_bytes(path: Path, value: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(value)
        os.replace(temporary, path)
    finally:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def api_request(server: str, path: str, token: str = "", payload: Any = None) -> Any:
    url = server.rstrip("/") + PREFIX + path
    headers = {"Accept": "application/json"}
    data = None
    method = "GET"
    if payload is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        method = "POST"
    if token:
        headers["Authorization"] = "Bearer " + token
    request = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.loads(response.read().decode("utf-8"))
    except urllib.error.HTTPError as exc:
        try:
            body = json.loads(exc.read().decode("utf-8"))
            message = body.get("error") or str(exc)
        except (UnicodeDecodeError, json.JSONDecodeError):
            message = str(exc)
        raise CliError(message) from exc
    except urllib.error.URLError as exc:
        raise CliError("Could not reach ComfyUI at %s: %s" % (server, exc.reason)) from exc


def api_download(server: str, asset: dict[str, Any], token: str = "") -> bytes:
    filename = str(asset.get("filename") or "").strip()
    provider = str(asset.get("provider") or "").strip().lower()
    if provider == "h3_project_assets":
        project = str(asset.get("project") or "").strip()
        asset_id = str(asset.get("asset_id") or "").strip()
        if not filename or not project or not asset_id:
            raise CliError("ComfyUI published an invalid project image descriptor.")
        query = urllib.parse.urlencode({
            "project": project, "asset": asset_id, "variant": "original",
        })
        url = (
            server.rstrip("/")
            + "/minimax_h3_context_loop/project-assets/media?" + query
        )
    else:
        subfolder = str(asset.get("subfolder") or "").strip()
        media_type = str(asset.get("type") or "input").strip().lower()
        if not filename or media_type not in {"input", "output", "temp"}:
            raise CliError("ComfyUI published an invalid image asset descriptor.")
        query = urllib.parse.urlencode({
            "filename": filename,
            "subfolder": subfolder,
            "type": media_type,
        })
        url = server.rstrip("/") + "/view?" + query
    headers = {"Accept": "image/*"}
    if token:
        headers["Authorization"] = "Bearer " + token
    request = urllib.request.Request(
        url,
        headers=headers,
        method="GET",
    )
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            try:
                declared = int(response.headers.get("Content-Length") or 0)
            except (TypeError, ValueError):
                declared = 0
            if declared > MAX_IMAGE_BYTES:
                raise CliError("Image asset %s exceeds the 100 MiB limit." % filename)
            content = response.read(MAX_IMAGE_BYTES + 1)
            if len(content) > MAX_IMAGE_BYTES:
                raise CliError("Image asset %s exceeds the 100 MiB limit." % filename)
            if not content:
                raise CliError("ComfyUI returned an empty image asset for %s." % filename)
            return content
    except urllib.error.HTTPError as exc:
        raise CliError("Could not download image asset %s: %s" % (filename, exc)) from exc
    except urllib.error.URLError as exc:
        raise CliError("Could not reach ComfyUI at %s: %s" % (server, exc.reason)) from exc


def safe_filename(value: str) -> str:
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("._-")
    return (name or "scene")[:80]


def workspace_path(directory: Path, relative: str) -> Path:
    root = directory.resolve()
    path = (root / relative).resolve()
    if Path(relative).is_absolute() or not path.is_relative_to(root) or path == root:
        raise CliError("Workspace state contains an unsafe path: %s" % relative)
    return path


def load_state(directory: Path) -> tuple[configparser.ConfigParser, dict[str, dict[str, str]]]:
    path = workspace_path(directory, STATE_FILE)
    if not path.is_file():
        raise CliError("%s is not a Grok Bridge workspace; run h3-grok pull first." % directory)
    config = configparser.ConfigParser(interpolation=None)
    config.optionxform = str
    config.read(path, encoding="utf-8")
    if config.get("bridge", "format", fallback="") != FORMAT:
        raise CliError("Unsupported Grok Bridge workspace format.")
    scenes = {}
    for encoded_id, value in config.items("scenes"):
        fields = value.split("\t")
        if len(fields) != 3:
            raise CliError("The Grok Bridge workspace state is damaged.")
        scenes[urllib.parse.unquote(encoded_id)] = {
            "path": fields[0], "hash": fields[1], "index": fields[2],
        }
    return config, scenes


def find_workspace(value: str = ".") -> Path:
    directory = Path(value).expanduser().resolve()
    for candidate in (directory, *directory.parents):
        if (candidate / STATE_FILE).is_file():
            return candidate
    raise CliError("No Grok Bridge workspace here. Click Edit with Grok in ComfyUI first.")


def save_state(directory: Path, server: str, project: dict[str, Any]) -> None:
    config = configparser.ConfigParser(interpolation=None)
    config.optionxform = str
    config["bridge"] = {
        "format": FORMAT,
        "server": server.rstrip("/"),
        "project": project["project_id"],
        "revision": project["revision"],
    }
    config["scenes"] = {}
    for scene in project["scenes"]:
        relative = "scenes/%03d-%s.md" % (
            int(scene["index"]), safe_filename(scene["id"]))
        config["scenes"][urllib.parse.quote(scene["id"], safe="")] = "\t".join((
            relative, scene["prompt_hash"], str(scene["index"]),
        ))
    from io import StringIO
    output = StringIO()
    config.write(output)
    atomic_text(workspace_path(directory, STATE_FILE), output.getvalue())


def human_value(value: Any) -> str:
    if value is None:
        return "—"
    if isinstance(value, bool):
        return "yes" if value else "no"
    if isinstance(value, list):
        return ", ".join(human_value(item) for item in value)
    if isinstance(value, dict):
        return "; ".join("%s=%s" % (key, human_value(item)) for key, item in value.items())
    return str(value).replace("\n", " ")


def project_markdown(project: dict[str, Any]) -> str:
    lines = [
        "# %s" % project["project_id"], "",
        "This folder is a plain-text mirror of the live ComfyUI H3 prompt project.",
        "Edit files under `scenes/`, then run `h3-grok sync` to apply them in ComfyUI.",
        "Keep the connected ComfyUI editor open. Sync confirms when the edits are applied.", "",
        "## Scenes", "",
        "| # | Scene ID | Prompt file | Settings |",
        "|---:|---|---|---|",
    ]
    for scene in project["scenes"]:
        filename = "scenes/%03d-%s.md" % (
            int(scene["index"]), safe_filename(scene["id"]))
        settings = "; ".join(
            "%s=%s" % (key, human_value(value))
            for key, value in scene.get("metadata", {}).items()
            if key != "id"
        ) or "inherited"
        lines.append("| %d | `%s` | `%s` | %s |" % (
            scene["index"], scene["id"], filename, settings))
    lines.extend(("", "See `SHARED.md` and `REFERENCES.md` for project context.", ""))
    return "\n".join(lines)


def references_markdown(
        project: dict[str, Any], asset_paths: dict[int, str] | None = None) -> str:
    asset_paths = asset_paths or {}
    lines = [
        "# Reference and semantic context", "",
        "These records describe tokens available to scene prompts. Project Carousel and "
        "connected picture files are copied into `assets/`.", "",
    ]
    references = project.get("references") or []
    if not references:
        lines.extend(("No connected prompt reference nodes were discovered.", ""))
        return "\n".join(lines)
    for index, reference in enumerate(references):
        token = reference.get("native_token") or reference.get("semantic_token") or reference.get("tag")
        lines.extend((
            "## %s" % token,
            "",
            "- Kind: %s" % reference.get("kind", "reference"),
            "- Native token: %s" % (reference.get("native_token") or "not available"),
            "- Semantic token: %s" % (reference.get("semantic_token") or "not available"),
            "- Active scenes: %s" % human_value(reference.get("active_scenes") or []),
            "- Available scenes: %s" % human_value(reference.get("available_scenes") or "all"),
            "- Selector: %s" % (reference.get("selector") or "prompt tag"),
            "- Source: %s" % (reference.get("source") or "connected graph input"),
        ))
        if index in asset_paths:
            local = asset_paths[index]
            lines.append("- Local asset: [%s](%s)" % (Path(local).name, local))
        elif reference.get("kind") == "picture":
            lines.append("- Local asset: unavailable (no file-backed ComfyUI image found)")
        else:
            lines.append("- Local asset: not copied (picture references only)")
        for key, value in (reference.get("semantics") or {}).items():
            lines.append("- %s: %s" % (key.replace("_", " ").title(), human_value(value)))
        lines.append("")
    return "\n".join(lines)


def download_picture_assets(
        directory: Path, project: dict[str, Any], server: str,
        token: str = "") -> dict[int, str]:
    paths: dict[int, str] = {}
    downloaded: dict[tuple[str, ...], str] = {}
    claimed: dict[str, tuple[str, ...]] = {}
    for index, reference in enumerate(project.get("references") or []):
        if reference.get("kind") != "picture" or not isinstance(reference.get("asset"), dict):
            continue
        asset = reference["asset"]
        if asset.get("provider") == "h3_project_assets":
            key = (
                "h3_project_assets",
                str(asset.get("project") or ""),
                str(asset.get("asset_id") or ""),
            )
        else:
            key = (
                str(asset.get("type") or "input"),
                str(asset.get("subfolder") or ""),
                str(asset.get("filename") or ""),
            )
        source_name = Path(str(asset.get("filename") or "").replace("\\", "/")).name
        source_suffix = Path(source_name).suffix.lower()
        suffix = source_suffix if re.fullmatch(r"\.[a-z0-9]{1,10}", source_suffix) else ""
        old_token_name = (
            reference.get("tag") or reference.get("native_token")
            or reference.get("semantic_token") or "picture"
        )
        tag = str(reference.get("tag") or "").strip().lstrip("@#")
        if not tag:
            native = str(reference.get("native_token") or "").strip()
            semantic = str(reference.get("semantic_token") or "").strip()
            if native.startswith("@"):
                tag = native[1:]
            elif semantic.startswith("#"):
                tag = semantic[1:].split("[", 1)[0]
            else:
                tag = Path(source_name).stem or "picture"
        relative = "assets/%s%s" % (safe_filename(tag), suffix)
        owner = claimed.get(relative)
        if owner is not None and owner != key:
            raise CliError(
                "Picture reference tags must be unique; more than one image maps to %s."
                % relative)
        claimed[relative] = key
        existing = downloaded.get(key)
        if existing is None:
            destination = workspace_path(directory, relative)
            atomic_bytes(destination, api_download(server, asset, token))
            downloaded[key] = relative
        elif existing != relative:
            atomic_bytes(workspace_path(directory, relative), workspace_path(directory, existing).read_bytes())
        old_relative = "assets/%03d-%s-%s" % (
            index + 1, safe_filename(str(old_token_name)), safe_filename(source_name))
        if old_relative != relative:
            try:
                workspace_path(directory, old_relative).unlink()
            except FileNotFoundError:
                pass
        paths[index] = relative
    return paths


def guard_local_edits(directory: Path, old_scenes: dict[str, dict[str, str]],
                      project: dict[str, Any], force: bool) -> None:
    remote = {scene["id"]: scene for scene in project["scenes"]}
    conflicts = []
    tracked = {}
    for scene_id, record in old_scenes.items():
        path = workspace_path(directory, record["path"])
        tracked[path] = record
        if not path.is_file():
            continue
        local_hash = text_hash(path.read_text(encoding="utf-8"))
        remote_hash = remote.get(scene_id, {}).get("prompt_hash")
        if local_hash not in (record["hash"], remote_hash):
            conflicts.append(record["path"])
    for scene in project["scenes"]:
        relative = "scenes/%03d-%s.md" % (int(scene["index"]), safe_filename(scene["id"]))
        path = workspace_path(directory, relative)
        if path.is_file() and path not in tracked:
            if text_hash(path.read_text(encoding="utf-8")) != scene["prompt_hash"]:
                conflicts.append(relative)
    if conflicts and not force:
        raise CliError(
            "Local edits would be overwritten: %s. Send them first or use --force."
            % ", ".join(conflicts))


def pull_command(args: argparse.Namespace) -> None:
    server, project_id, directory = workspace_target(args)
    query = urllib.parse.urlencode({"project_id": project_id})
    project = api_request(server, "/project?" + query, args.token)
    old_scenes = {}
    if (directory / STATE_FILE).is_file():
        old_config, old_scenes = load_state(directory)
        if (old_config["bridge"]["server"].rstrip("/") != server
                or old_config["bridge"]["project"] != project_id):
            raise CliError("This folder belongs to a different project or server. Use another folder.")
    guard_local_edits(directory, old_scenes, project, args.force)
    directory.mkdir(parents=True, exist_ok=True)
    asset_paths = download_picture_assets(directory, project, server, args.token)
    atomic_text(workspace_path(directory, "PROJECT.md"), project_markdown(project))
    atomic_text(workspace_path(directory, "SHARED.md"), str(project.get("shared_prompt") or ""))
    atomic_text(workspace_path(directory, "REFERENCES.md"), references_markdown(project, asset_paths))
    for scene in project["scenes"]:
        relative = "scenes/%03d-%s.md" % (
            int(scene["index"]), safe_filename(scene["id"]))
        atomic_text(workspace_path(directory, relative), scene["prompt"])
    save_state(directory, server, project)
    print("Pulled %d scenes and %d image asset%s to %s" % (
        len(project["scenes"]), len(set(asset_paths.values())),
           "" if len(set(asset_paths.values())) == 1 else "s", directory))


def workspace_target(args: argparse.Namespace) -> tuple[str, str, Path]:
    if args.project:
        if not args.server or urllib.parse.urlsplit(args.server).scheme not in {"http", "https"}:
            raise CliError("Use h3-grok edit <ComfyUI URL> <project>, or h3-grok edit <folder>.")
        return (args.server.rstrip("/"), args.project,
                Path(args.directory or args.project).expanduser().resolve())
    directory = find_workspace(args.directory or args.server or ".")
    config, _scenes = load_state(directory)
    return config["bridge"]["server"].rstrip("/"), config["bridge"]["project"], directory


def edit_command(args: argparse.Namespace) -> None:
    executable = shutil.which("grok")
    if not executable:
        raise CliError("The grok command is not installed on this machine.")
    _server, _project_id, directory = workspace_target(args)
    dirty = False
    if (directory / STATE_FILE).is_file():
        config, scenes = load_state(directory)
        if config["bridge"]["server"].rstrip("/") != _server or config["bridge"]["project"] != _project_id:
            raise CliError("This folder belongs to a different project or server. Use another folder.")
        for record in scenes.values():
            path = workspace_path(directory, record["path"])
            if not path.is_file():
                raise CliError("Missing scene file %s. Restore it or run h3-grok pull." % record["path"])
            dirty |= text_hash(path.read_text(encoding="utf-8")) != record["hash"]
    if dirty:
        print("Opening your existing local edits. They have not been overwritten.", flush=True)
    else:
        pull_command(args)
    skill_source = Path(__file__).resolve().parent / ".grok/skills/h3-grok-bridge/SKILL.md"
    if skill_source.is_file():
        skill_target = workspace_path(directory, ".grok/skills/h3-grok-bridge/SKILL.md")
        if not skill_target.exists():
            atomic_text(skill_target, skill_source.read_text(encoding="utf-8"))
    instructions = (
        "This is an H3 Grok Bridge prompt workspace. Read PROJECT.md, SHARED.md, "
        "and REFERENCES.md, and inspect relevant images in assets/. Edit requested "
        "scene files under scenes/ as plain prompt text, preserving scene IDs and "
        "reference tags. After each completed requested edit, run h3-grok sync "
        "from this folder to apply it in the connected ComfyUI editor. Only report "
        "success when sync confirms application. Keep conflicts as local drafts; "
        "do not use --force or cancel pending edits without the user's instruction. "
    )
    instructions += args.prompt or "Read the context, then ask what the user would like to change."
    environment = os.environ.copy()
    if args.token:
        environment["COMFYUI_API_TOKEN"] = args.token
    result = subprocess.run([executable, instructions], cwd=directory, env=environment, check=False)
    if result.returncode:
        raise CliError("Grok exited with status %d. Your scene files are still in %s."
                       % (result.returncode, directory))


def selected_scene(scene_id: str, record: dict[str, str], requested: list[str]) -> bool:
    if not requested:
        return True
    choices = {scene_id, record["index"], Path(record["path"]).stem}
    return any(value in choices for value in requested)


def local_changes(args: argparse.Namespace):
    directory = find_workspace(args.directory)
    config, scenes = load_state(directory)
    for requested in args.scene:
        if not any(selected_scene(scene_id, record, [requested]) for scene_id, record in scenes.items()):
            raise CliError("No scene matches %s." % requested)
    changes = []
    for scene_id, record in scenes.items():
        if not selected_scene(scene_id, record, args.scene):
            continue
        path = workspace_path(directory, record["path"])
        if not path.is_file():
            raise CliError("Missing scene file %s." % record["path"])
        prompt = path.read_text(encoding="utf-8")
        if text_hash(prompt) == record["hash"]:
            continue
        changes.append({
            "scene_id": scene_id,
            "base_prompt_hash": record["hash"],
            "prompt": prompt,
        })
    return directory, config, changes


def send_command(args: argparse.Namespace) -> None:
    directory, config, changes = local_changes(args)
    if not changes:
        print("No changed scene prompts to send.")
        return
    result = api_request(
        config["bridge"]["server"], "/changes", args.token,
        {
            "project_id": config["bridge"]["project"],
            "base_revision": config["bridge"]["revision"],
            "changes": changes,
        },
    )
    if result.get("applied"):
        save_state(directory, config["bridge"]["server"], result["project"])
        print("These scene edits were already applied in ComfyUI. Local baseline refreshed.")
        return
    print(
        "Staged %d scene edit%s as %s. Click Grok Pull in ComfyUI."
        % (len(result["changes"]), "" if len(result["changes"]) == 1 else "s",
           result["change_id"][:12]))


def sync_command(args: argparse.Namespace) -> None:
    if not math.isfinite(args.timeout) or args.timeout < 0:
        raise CliError("Sync timeout must be a finite, non-negative number of seconds.")
    directory, config, changes = local_changes(args)
    if not changes:
        print("No changed scene prompts to sync.")
        return
    server, project_id = config["bridge"]["server"], config["bridge"]["project"]
    result = api_request(server, "/changes", args.token, {
        "project_id": project_id, "base_revision": config["bridge"]["revision"],
        "changes": changes, "auto_apply": True,
    })
    change_id = result["change_id"]
    deadline = time.monotonic() + args.timeout
    while not result.get("applied"):
        query = urllib.parse.urlencode({"project_id": project_id, "change_id": change_id})
        result = api_request(server, "/status?" + query, args.token)
        if result.get("applied"):
            break
        if result.get("change_id") != change_id:
            raise CliError("The pending edit was cancelled or replaced. Your local files were kept.")
        if result.get("error"):
            raise CliError("ComfyUI kept its current Plan: %s Your local files were kept."
                           % result["error"])
        if time.monotonic() >= deadline:
            raise CliError("Edits are waiting for ComfyUI. Keep the connected editor open, "
                           "then run h3-grok sync again or click Grok Pull. Local files were kept.")
        time.sleep(min(0.5, max(0, deadline - time.monotonic())))
    project = result["project"]
    if project["project_id"] != project_id:
        raise CliError("ComfyUI confirmed a different project; local state was not changed.")
    # Update only the baseline. Edits made locally while waiting remain unsent changes.
    save_state(directory, server, project)
    print("Applied %d scene edit%s in ComfyUI. Ready for the next edit."
          % (len(changes), "" if len(changes) == 1 else "s"))


def cancel_command(args: argparse.Namespace) -> None:
    directory = find_workspace(args.directory)
    config, _scenes = load_state(directory)
    result = api_request(config["bridge"]["server"], "/cancel", args.token,
                         {"project_id": config["bridge"]["project"]})
    print("Pending edits cancelled. Local scene files were kept." if result["cancelled"]
          else "No pending edits to cancel.")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(
        prog="h3-grok",
        description="Mirror H3 ComfyUI scene prompts as plain Markdown files.",
    )
    subcommands = result.add_subparsers(dest="command", required=True)
    pull = subcommands.add_parser("pull", help="Pull a published ComfyUI project.")
    pull.add_argument("server", nargs="?", help="ComfyUI URL or existing workspace folder")
    pull.add_argument("project", nargs="?", help="Bridge project id; omitted in an existing workspace")
    pull.add_argument("directory", nargs="?", help="Destination; defaults to project id")
    pull.add_argument("--force", action="store_true", help="Overwrite conflicting local edits")
    pull.add_argument("--token", default=os.environ.get("COMFYUI_API_TOKEN", ""),
                      help="Bearer token; prefer COMFYUI_API_TOKEN")
    pull.set_defaults(function=pull_command)

    send = subcommands.add_parser("send", help="Stage locally edited scene prompts.")
    send.add_argument("directory", nargs="?", default=".", help="Workspace folder")
    send.add_argument("--scene", action="append", default=[],
                      help="Only send this scene id, number, or filename stem; repeatable")
    send.add_argument("--token", default=os.environ.get("COMFYUI_API_TOKEN", ""),
                      help="Bearer token; prefer COMFYUI_API_TOKEN")
    send.set_defaults(function=send_command)

    edit = subcommands.add_parser("edit", help="Prepare a workspace and open it in Grok.")
    edit.add_argument("server", nargs="?", help="ComfyUI URL or existing workspace folder")
    edit.add_argument("project", nargs="?", help="Project id when using a URL")
    edit.add_argument("directory", nargs="?", help="Destination; defaults to project id")
    edit.add_argument("--prompt", help="Initial editing request for Grok")
    edit.add_argument("--token", default=os.environ.get("COMFYUI_API_TOKEN", ""))
    edit.set_defaults(function=edit_command, force=False)

    sync = subcommands.add_parser("sync", help="Apply local scene edits in the open ComfyUI editor.")
    sync.add_argument("directory", nargs="?", default=".", help="Workspace folder")
    sync.add_argument("--scene", action="append", default=[])
    sync.add_argument("--timeout", type=float, default=30, help="Seconds to wait for ComfyUI (default 30)")
    sync.add_argument("--token", default=os.environ.get("COMFYUI_API_TOKEN", ""))
    sync.set_defaults(function=sync_command)

    cancel = subcommands.add_parser("cancel", help="Discard pending remote edits; keep local scene files.")
    cancel.add_argument("directory", nargs="?", default=".")
    cancel.add_argument("--token", default=os.environ.get("COMFYUI_API_TOKEN", ""))
    cancel.set_defaults(function=cancel_command)
    return result


def main() -> int:
    try:
        args = parser().parse_args()
        args.function(args)
        return 0
    except (CliError, OSError, KeyError, configparser.Error, json.JSONDecodeError) as exc:
        print("h3-grok: %s" % exc, file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
